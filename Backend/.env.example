# ============================================================
#  RoomSetu Backend — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ============================================================

# Application
NODE_ENV=development
PORT=5000

# MongoDB Atlas
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/roomsetu?retryWrites=true&w=majority

# JWT Secrets — use a strong random string (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_strong_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret_min_32_chars

# JWT Expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client URL (used for CORS and redirect links)
CLIENT_URL=http://localhost:5173

# CORS allowed origins (comma-separated, no trailing slash)
# In development: http://localhost:5173
# In production:  https://roomsetu.in,https://www.roomsetu.in
CORS_ORIGINS=http://localhost:5173

# Security & Monitoring (Phase 11)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── Cloudinary — Image Uploads ────────────────────────────────────────────────
# Required for POST /api/v1/uploads/images
# Without these the upload endpoint returns 503 "Image upload service is not configured."
# The server starts normally without them.
# Get your credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=wagr1d79
CLOUDINARY_API_KEY=671367782876573
CLOUDINARY_API_SECRET=SlrHGpAIYPlR874mHpfBvWcVTo8

# ── SMTP — Email Notifications (Feedback) ────────────────────────────────────
# Required for sending feedback notification emails.
# Without these, emails are silently skipped; feedback is still saved to MongoDB.
# For Gmail, use an App Password (never your normal Gmail account password):
#   https://support.google.com/accounts/answer/185833
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465      (SSL/TLS) or 587 (STARTTLS)
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_PASS=         <- Gmail App Password (16 chars, no spaces)
# FEEDBACK_RECEIVER_EMAIL=himanshusinghbisht0011@gmail.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FEEDBACK_RECEIVER_EMAIL=
